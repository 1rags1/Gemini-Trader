# Copy to .env and fill in. .env is git-ignored; this template is not.
# Never commit .env, API keys, or state/runner.json.
GEMINI_API_KEY=your_key_here

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-3.6-flash
# Per-request HTTP timeout in milliseconds.
GEMINI_TIMEOUT_MS=20000
# Any ccxt id; binance returns 451 in some regions. coinbase/kucoin/okx also work.
EXCHANGE_ID=kraken
SYMBOL=BTC/USD
# One book only: Kraken USD pairs. USDT, USDC, and ZUSD names in old state
# are aliases, not a second book. The runner folds them onto BTC/ETH/SOL USD.
TRADING_PAIRS=BTC/USD,ETH/USD,SOL/USD

# Practice mode is what you copy. The native runner sends real Kraken orders
# only when BOTH of these are set: PAPER_TRADING=false and ALLOW_LIVE_TRADING=true.
# Paper off without the live gate fails closed and places nothing.
PAPER_TRADING=true
ALLOW_LIVE_TRADING=false

USE_POST_ONLY=true
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
CANDLE_LIMIT=500
PAPER_STARTING_BALANCE=10000
# One-shot paper reset. Archives state/runner.json and starts equity at
# PAPER_STARTING_BALANCE. Does not delete live.json. Unset this after one
# start, or every restart wipes the paper book. The CLI flag is --reset-paper.
# RESET_PAPER=true
# Share of equity for each new position. 0.25 with MAX_OPEN_POSITIONS=2
# uses about half of equity and leaves a cash buffer for fees and slippage.
POSITION_SIZE_FRACTION=0.25
MAX_OPEN_POSITIONS=2
SPOT_LONG_ONLY=true
ATR_STOP_MULTIPLIER=1.5
ATR_PROFIT_MULTIPLIER=3.5
# 1h ADX at or above this is a tradable trend (default 16, was 20).
# BULL: close > EMA200, EMA21 > EMA55, ADX >= threshold.
# SOFT_BULL: close > EMA200 and ADX >= threshold even if EMA21 is not above
# EMA55. Soft bull still uses the 15m EMA pullback (tag EMA21, close back
# above it). It is not a blind EMA cross.
# BEAR blocks longs: close < EMA200, EMA21 < EMA55, ADX >= threshold.
# Mixed stacks and weak ADX stay NEUTRAL and do not enter.
MACRO_ADX_THRESHOLD=16
# No new entries from Saturday 00:00 UTC through Sunday 12:00 UTC (~36h).
# Exits still run. Weekday is Monday=0 ... Sunday=6. The end hour is
# exclusive, so Sunday 12:00 UTC can enter again.
WEEKEND_STAND_DOWN=true
WEEKEND_STAND_DOWN_START_WEEKDAY=5
WEEKEND_STAND_DOWN_START_HOUR=0
WEEKEND_STAND_DOWN_END_WEEKDAY=6
WEEKEND_STAND_DOWN_END_HOUR=12
# Used only if WEEKEND_STAND_DOWN is false (raises the ADX cut inside the window).
WEEKEND_ADX_THRESHOLD=25
POLL_INTERVAL_SECONDS=30
MACRO_TIMEFRAME=1h
TRIGGER_TIMEFRAME=15m
TIMEFRAME=15m

# Webhook listens on localhost unless you change this. An empty WEBHOOK_SECRET
# is only safe on localhost. A tunnel or any other bind requires the secret.
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=5000
WEBHOOK_SECRET=

# Dashboard listens on localhost unless you pass --host or set DASHBOARD_HOST.
# Binding 0.0.0.0 (or opening a tunnel) requires DASHBOARD_SECRET. If this is
# empty, WEBHOOK_SECRET is used instead. When a secret is set, every page and
# /api/snapshot request must send it (?token=, X-Dashboard-Token, or
# Authorization: Bearer). Prefer an SSH tunnel over a public bind:
#   ssh -L 8050:127.0.0.1:8050 user@your-vps
DASHBOARD_HOST=127.0.0.1
DASHBOARD_SECRET=
# true = open http://<vps-ip>:8050 with no token. Anyone who finds the IP can
# see balances and positions (read-only; the page cannot place orders).
DASHBOARD_PUBLIC=false
