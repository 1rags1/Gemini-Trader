# Copy to .env and fill in. .env is git-ignored; this template is not.
GEMINI_API_KEY=your_key_here

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-3.6-flash
# Per-request HTTP timeout in milliseconds.
GEMINI_TIMEOUT_MS=20000
# Any ccxt id; binance returns 451 in some regions. coinbase/kucoin/okx also work.
EXCHANGE_ID=kraken
SYMBOL=BTC/USDT
TIMEFRAME=1h
CANDLE_LIMIT=500
PAPER_STARTING_BALANCE=10000
