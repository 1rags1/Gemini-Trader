# Copy to .env and fill in. .env is git-ignored; this template is not.
GEMINI_API_KEY=your_key_here

# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-3.6-flash
# Per-request HTTP timeout in milliseconds.
GEMINI_TIMEOUT_MS=20000
# Any ccxt id; binance returns 451 in some regions. coinbase/kucoin/okx also work.
EXCHANGE_ID=kraken
SYMBOL=BTC/USD
TRADING_PAIRS=BTC/USD,ETH/USD,SOL/USD
PAPER_TRADING=false
USE_POST_ONLY=true
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
CANDLE_LIMIT=500
PAPER_STARTING_BALANCE=10000
POSITION_SIZE_FRACTION=0.48
MAX_OPEN_POSITIONS=2
SPOT_LONG_ONLY=true
ATR_STOP_MULTIPLIER=1.5
ATR_PROFIT_MULTIPLIER=3.5
POLL_INTERVAL_SECONDS=30
MACRO_TIMEFRAME=1h
TRIGGER_TIMEFRAME=15m
TIMEFRAME=15m
# Required before you tunnel the dashboard to a phone. WEBHOOK_SECRET is used
# if this is left empty.
DASHBOARD_SECRET=
